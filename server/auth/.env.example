# HTTPS reverse proxy must run on the same host. This server binds loopback only.
AUTH_LISTEN_HOST=127.0.0.1
AUTH_PORT=8787
AUTH_PUBLIC_URL=https://login.example.com
# Enable only when the same-host reverse proxy overwrites X-Real-IP with the direct client IP.
AUTH_TRUST_PROXY_IP=1
AUTH_MYSQL_URL=mysql://auth_user:CHANGE_ME@127.0.0.1:3306/ai_agent_auth
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_CODE_SECRET=CHANGE_TO_RANDOM_SECRET_AT_LEAST_32_BYTES
# Only for local HTTPS-free development, never deploy this in production.
# AUTH_INSECURE_LOCAL_DEV=1

# Tencent Cloud SMS v20210111; leave unset until reviewed credentials exist.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN=
TENCENT_SMS_TEMPLATE_ID=

# Approved website applications only. Callback URLs must be registered as:
# https://login.example.com/v1/auth/oauth/callback/qq
# https://login.example.com/v1/auth/oauth/callback/wechat
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
